#!/bin/sh /etc/rc.common
# procd service for marksocks. UCI (/etc/config/marksocks) only enables the service and
# names the TOML file; all runtime settings, including credentials, live in that file,
# so nothing secret ever appears on the command line.

USE_PROCD=1
START=95

PROG=/usr/bin/marksocks

validate_marksocks_section() {
	uci_load_validate marksocks marksocks "$1" "$2" \
		'enabled:bool:0' \
		'config_file:file:/etc/marksocks/config.toml'
}

start_marksocks_instance() {
	local section="$1" out

	[ "$2" = 0 ] || {
		logger -t marksocks -p daemon.err "section '$section': invalid UCI settings, not starting"
		return 1
	}
	[ "$enabled" = 1 ] || return 0

	# Refuse to start on an invalid TOML file instead of letting procd respawn-loop it.
	# The error text never contains credentials (the binary redacts source lines).
	out="$("$PROG" --check --config "$config_file" 2>&1)" || {
		logger -t marksocks -p daemon.err "not starting: $out"
		return 1
	}

	procd_open_instance "$section"
	procd_set_param command "$PROG" --config "$config_file"
	# A changed TOML file makes `service marksocks reload` restart the instance.
	procd_set_param file "$config_file"
	procd_set_param respawn
	# marksocks gives open connections 5 s after SIGTERM; procd's default is to SIGKILL at 5 s.
	procd_set_param term_timeout 10
	# max_connections defaults to 512 and each relay holds 2+ fds.
	procd_set_param limits nofile="4096 4096"
	procd_set_param stderr 1
	procd_close_instance
}

start_service() {
	config_load marksocks
	config_foreach validate_marksocks_section marksocks start_marksocks_instance
}

service_triggers() {
	procd_add_reload_trigger marksocks
	procd_add_validation validate_marksocks_section
}
